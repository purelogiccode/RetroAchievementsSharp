<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net9.0;net8.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet package metadata -->
    <IsPackable>true</IsPackable>
    <PackageId>RetroAchievementsSharp</PackageId>
    <Version>1.1.0</Version>
    <Authors>Peterson Fernandes; Pure Logic Code</Authors>
    <Owners>Peterson Fernandes; Pure Logic Code</Owners>
    <Title>RetroAchievementsSharp</Title>
    <Description>A native C# port of the RetroAchievements hashing engine (rcheevos/RAHasher, MIT) that produces 100% identical hashes to the original for every supported console. Supports cartridge, disc (.cue/.bin/.iso/.gdi/.chd/.rvz/.wia), zip, m3u, Arcade, DOS and 3DS inputs.</Description>
    <PackageTags>RetroAchievements;rcheevos;RAHasher;hash;hashing;rom;iso;disc;chd;rvz;wia;gamecube;wii;3ds;nes;snes;n64;playstation</PackageTags>
    <PackageLicenseExpression>GPL-2.0-or-later</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/purelogiccode/RetroAchievementsSharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/purelogiccode/RetroAchievementsSharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryBranch>master</RepositoryBranch>
    <PackageReleaseNotes>https://github.com/purelogiccode/RetroAchievementsSharp/blob/master/CHANGELOG.md</PackageReleaseNotes>
    <Copyright>Copyright (c) 2026 Peterson Fernandes (drpetersonfernandes) and Pure Logic Code</Copyright>

    <!-- symbols, source link and reproducible packs -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>

    <!-- Microsoft.SourceLink.GitHub 11.x's build-time task pulls
         System.IO.Hashing 11, which emits TFM-support warnings for net8/net9.
         SourceLink is PrivateAssets=all and the runtime hashing graph
         (CHDSharp 1.6.3) resolves System.IO.Hashing 10.0.14 for those TFMs. -->
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>

    <!-- XML docs are packed (GenerateDocumentationFile); CS1591 (missing
         doc comments) is an error via Directory.Build.props
         (TreatWarningsAsErrors), so new public members must be documented -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- guards consumer compatibility on every future pack build -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <Company>PureLogicCode.com</Company>
    <AssemblyVersion>1.1.0</AssemblyVersion>
    <FileVersion>1.1.0</FileVersion>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <!-- 1.6.3 is the last CHDSharp release whose net9.0 dependency graph uses
         Microsoft.Extensions.Logging.Abstractions 10.x. CHDSharp 1.7.x pulls
         Logging.Abstractions 11.x, whose only net9-compatible asset is
         netstandard2.0 and drags in System.Diagnostics.DiagnosticSource 11,
         which breaks System.Net.Http on .NET 9. CHDSharp 1.7.0/1.7.1 contain
         no public API or reader changes (TFM support and encoder fixes only);
         the net10.0 reader is used on net11.0. -->
    <PackageReference Include="CHDSharp" Version="1.6.3" />
    <PackageReference Include="RVZSharp" Version="1.2.0" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="VideoGameFileSystemParser" Version="1.4.0" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="11.0.100" PrivateAssets="all" />
    <PackageReference Update="Meziantou.Analyzer" Version="3.0.341" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
    <None Include="icon\icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RetroAchievementsSharp.Tests" />
  </ItemGroup>

</Project>