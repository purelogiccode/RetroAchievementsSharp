<Project>
  <PropertyGroup>
    <!-- Each project declares its own TargetFrameworks: RetroAchievementsSharp,
         RetroAchievementsSharp.Cli and RetroAchievementsSharp.Tests all
         multi-target net10.0;net11.0. CHDSharp, RVZSharp,
         VideoGameFileSystemParser, and Serilog ship libraries compatible with
         every supported TFM. -->
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Code-quality analyzers (build-time only, never a runtime dependency) -->
    <PackageReference Include="Meziantou.Analyzer" Version="3.0.156" PrivateAssets="all" />
  </ItemGroup>
</Project>